<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><corners android:radius="8dp" /><stroke android:width="2dp" android:color="#AAAAAA" /><solid android:color="#FFFFFF" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="8dp" /><solid android:color="#000000" /></shape>
    </item>
    <item>
        <shape><corners android:radius="8dp" /><stroke android:width="2dp" android:color="#000000" /><solid android:color="#FFFFFF" /></shape>
    </item>
</selector>
